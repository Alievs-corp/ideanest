{
  "name": "@ideanest/checkout",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "The checkout's platform-neutral rules: the pledge wire types, the client preview quote, idempotency keys, the refusal behaviour table, the field refusal wording, and the pledge manager's rules (controls by state, payment-return outcomes, the Merge-Patch edit), shared by apps/web and apps/mobile.",
  "exports": {
    "./types": "./src/types.ts",
    "./quote": "./src/quote.ts",
    "./idempotency": "./src/idempotency.ts",
    "./failure": "./src/failure.ts",
    "./refusals": "./src/refusals.ts",
    "./attempt": "./src/attempt.ts",
    "./reservation": "./src/reservation.ts",
    "./draft": "./src/draft.ts",
    "./pledge": "./src/pledge.ts",
    "./edit": "./src/edit.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ideanest/api-client": "workspace:*",
    "@ideanest/messages": "workspace:*",
    "@ideanest/money": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
