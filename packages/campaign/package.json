{
  "name": "@ideanest/campaign",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "The campaign page's platform-neutral rules: which states have a page and take pledges, the 80% threshold, the countdown, the tabs, the story reader, the live counter's wire format and reconnect policy, the community wire readers and the report vocabulary, shared by apps/web and apps/mobile.",
  "exports": {
