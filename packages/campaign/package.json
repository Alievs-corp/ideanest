    "./pledgeable": "./src/pledgeable.ts",
    "./threshold": "./src/threshold.ts",
    "./completion": "./src/completion.ts",
    "./deadline": "./src/deadline.ts",
    "./days-left": "./src/days-left.ts",
    "./tabs": "./src/tabs.ts",
    "./story": "./src/story.ts",
    "./realtime": "./src/realtime.ts",
    "./comments": "./src/comments.ts",
    "./updates": "./src/updates.ts",
    "./faqs": "./src/faqs.ts",
    "./obligation": "./src/obligation.ts",
    "./report": "./src/report.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ideanest/messages": "workspace:*",
    "@ideanest/money": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "~22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
